<Project Sdk="Godot.NET.Sdk/4.7.0-dev.5">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'ios' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <!-- Release still compiles editor scripts registered by the Godot project. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <NoWarn>$(NoWarn);NETSDK1023</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <PackageReference Include="GodotSharpEditor" Version="4.7.0-dev.5" PrivateAssets="all" />
  </ItemGroup>
</Project>
