[gd_scene load_steps=15 format=3]

[ext_resource type="Script" path="res://addons/foveacore/scripts/vr/fovea_orbit_camera.gd" id="1_orbit"]
[ext_resource type="Script" path="res://addons/foveacore/scripts/fovea_splattable.gd" id="2_splattable"]
[ext_resource type="Script" path="res://addons/foveacore/scripts/advanced/splat_interaction_controller.gd" id="3_controller"]

[sub_resource type="ProceduralSkyMaterial" id="ProceduralSkyMaterial_1"]
sky_horizon_color = Color(0.64625, 0.65575, 0.67075, 1)
ground_horizon_color = Color(0.64625, 0.65575, 0.67075, 1)

[sub_resource type="Sky" id="Sky_1"]
sky_material = SubResource("ProceduralSkyMaterial_1")

[sub_resource type="Environment" id="Environment_1"]
background_mode = 2
sky = SubResource("Sky_1")
tonemap_mode = 2
glow_enabled = true

[sub_resource type="BoxMesh" id="BoxMesh_1"]
size = Vector3(1.5, 1.5, 1.5)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_cube"]
albedo_color = Color(0.5, 0.2, 0.2, 1)

[sub_resource type="SphereMesh" id="SphereMesh_1"]
radius = 0.8
height = 1.6

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_sphere"]
albedo_color = Color(0.2, 0.2, 0.5, 1)

[sub_resource type="CylinderMesh" id="CylinderMesh_1"]
top_radius = 0.6
bottom_radius = 0.6
height = 1.8

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_cylinder"]
albedo_color = Color(0.2, 0.5, 0.2, 1)

[sub_resource type="PlaneMesh" id="PlaneMesh_1"]
size = Vector2(20, 20)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_ground"]
albedo_color = Color(0.15, 0.25, 0.15, 1)
roughness = 0.9

[sub_resource type="GDScript" id="GDScript_source"]
script/source = "extends Node3D

@export var speed := 1.5
@export var amplitude := 4.0
var _time := 0.0

func _ready() -> void:
	add_to_group(\"interaction_sources\")

func _process(delta: float) -> void:
	_time += delta * speed
	position.x = sin(_time) * amplitude
"

[sub_resource type="SphereMesh" id="SphereMesh_source"]
radius = 0.25
height = 0.5

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_source"]
albedo_color = Color(0.9, 0.1, 0.1, 1)
roughness = 0.2
emission_enabled = true
emission = Color(0.9, 0.1, 0.1, 1)
emission_energy_multiplier = 2.0

[node name="TestDesktopScene" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_1")

[node name="DirectionalLight3D" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.866025, -0.353553, 0.353553, 0, 0.707107, 0.707107, -0.5, -0.612372, 0.612372, 0, 5, 0)
shadow_enabled = true

[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.939693, 0.34202, 0, -0.34202, 0.939693, 0, 3.5, 6.5)

[node name="FoveaOrbitCamera" type="Node" parent="Camera3D"]
script = ExtResource("1_orbit")
target = Vector3(0, 1, 0)
distance = 8.0

[node name="SplatInteractionController" type="Node" parent="."]
script = ExtResource("3_controller")
interaction_radius = 0.8
repulsion_force = 3.0
damping = 0.15

[node name="CubeMesh" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -2.5, 0.75, 0)
mesh = SubResource("BoxMesh_1")
surface_material_override/0 = SubResource("StandardMaterial3D_cube")

[node name="FoveaSplattable" type="Node3D" parent="CubeMesh"]
script = ExtResource("2_splattable")
splat_density = 1.0

[node name="SphereMesh" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.8, 0)
mesh = SubResource("SphereMesh_1")
surface_material_override/0 = SubResource("StandardMaterial3D_sphere")

[node name="FoveaSplattable" type="Node3D" parent="SphereMesh"]
script = ExtResource("2_splattable")
splat_density = 1.0

[node name="CylinderMesh" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 2.5, 0.9, 0)
mesh = SubResource("CylinderMesh_1")
surface_material_override/0 = SubResource("StandardMaterial3D_cylinder")

[node name="FoveaSplattable" type="Node3D" parent="CylinderMesh"]
script = ExtResource("2_splattable")
splat_density = 1.0

[node name="Ground" type="MeshInstance3D" parent="."]
mesh = SubResource("PlaneMesh_1")
surface_material_override/0 = SubResource("StandardMaterial3D_ground")

[node name="MovingInteractionSource" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.8, 0.5)
script = SubResource("GDScript_source")

[node name="SourceVisual" type="MeshInstance3D" parent="MovingInteractionSource"]
mesh = SubResource("SphereMesh_source")
surface_material_override/0 = SubResource("StandardMaterial3D_source")
