# Configuration
env = Environment()

# Variables
godot_cpp_path = "#godot-cpp"
target = ARGUMENTS.get("target", "template_release")
platform = ARGUMENTS.get("platform", "windows")
arch = ARGUMENTS.get("arch", "x86_64")

if platform != "windows" or target != "template_release" or arch != "x86_64":
    print("Unsupported C++ target: only windows/template_release/x86_64 is currently validated.")
    Exit(1)

# Compiler flags - MSVC compatible
if platform == "windows":
    env.Append(CXXFLAGS=["/std:c++17", "/O2", "/nologo", "/EHsc"])
    env.Append(CPPDEFINES=["GDEXTENSION", "NDEBUG"])
else:
    env.Append(CXXFLAGS=["-std=c++17", "-O3"])
    env.Append(CPPDEFINES=["GDEXTENSION", "NDEBUG"])

# Include paths - add gdextension directory from godot-cpp
env.Append(CPPPATH=[
    godot_cpp_path,
    godot_cpp_path + "/gen/include",
    godot_cpp_path + "/include",
    godot_cpp_path + "/gdextension",
    "#src"
])

# Libraries
godot_cpp_library = (
    f"godot-cpp/bin/libgodot-cpp.{platform}.{target}.{arch}.lib"
)
env.Append(LIBS=[
    godot_cpp_library
])

# Sources
sources = Glob("src/*.cpp")

# Keep the experimental C++ artifact distinct from the canonical Rust binary.
env.SharedLibrary(target="#bin/foveacore_cpp", source=sources)

print("Building FoveaCore GDExtension...")
print(f"  Platform: {platform}")
print(f"  Target: {target}")
print("  Output: bin/foveacore_cpp.dll")
